# Copy to .env for local development.
DATABASE_URL="file:./dev.db"
APP_URL=                     # public address, e.g. https://ezcanvas.example.edu; used in calendar feed links
AUTH_SECRET=                 # openssl rand -base64 32
APP_SECRET=                  # openssl rand -base64 32, encrypts stored Canvas tokens and API keys
RESEND_API_KEY=              # leave empty in development: sign in links print to the terminal
EMAIL_FROM="EZCanvas <onboarding@resend.dev>"
ANTHROPIC_MODEL=             # optional, defaults to claude-sonnet-5 for notes and email drafts
ANTHROPIC_FAST_MODEL=        # optional, defaults to claude-haiku-4-5-20251001 for quick checks
CANVAS_MOCK=                 # set to 1 to serve fixtures/canvas instead of calling Canvas
CANVAS_DEFAULT_BASE_URL=     # optional, prefills onboarding, e.g. https://canvas.yourschool.edu
