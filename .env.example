# Copy to .env for local development.
DATABASE_URL="file:./dev.db"
AUTH_SECRET=                 # openssl rand -base64 32
APP_SECRET=                  # openssl rand -base64 32, encrypts stored Canvas tokens and API keys
RESEND_API_KEY=              # leave empty in development: sign in links print to the terminal
EMAIL_FROM="EZCanvas <onboarding@resend.dev>"
CANVAS_MOCK=                 # set to 1 to serve fixtures/canvas instead of calling Canvas
CANVAS_DEFAULT_BASE_URL="https://canvas.cornell.edu"
