generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                  String  @id @default(cuid())
  email               String  @unique
  name                String
  institution         String?
  program             String?
  interfaceLanguage   String  @default("en")
  explanationLanguage String  @default("en")
  writingLanguage     String  @default("en")
}
