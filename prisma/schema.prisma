generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  emailVerified       DateTime?
  name                String?
  image               String?
  institution         String?
  program             String?
  aiProvider          String?
  aiKey               String?   // encrypted with lib/crypto.ts
  // Secret in the .ics feed URL, so a calendar app can subscribe without signing in.
  calendarToken       String?   @unique
  interfaceLanguage   String    @default("en")
  explanationLanguage String    @default("en")
  writingLanguage     String    @default("en")
  // IANA zone reported by the student's browser; all day and hour maths use it.
  timeZone            String    @default("UTC")
  sessions            Session[]
  connections         Connection[]
  courses             Course[]
  calendarItems       CalendarItem[]
  groups              Group[]
  conversations       Conversation[]
}

// Auth.js session and magic link tables, shapes from @auth/prisma-adapter.
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Connection {
  id            String    @id @default(cuid())
  userId        String
  type          String
  baseUrl       String
  token         String    // encrypted with lib/crypto.ts
  status        String    @default("connected")
  lastSyncAt    DateTime?
  // Set while a sync runs, so the timer, onboarding and Sync now never run two at once.
  syncStartedAt DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model Course {
  id            String         @id @default(cuid())
  userId        String
  canvasId      Int
  code          String
  name          String
  term          String?
  instructor    String?
  color         Int
  syllabus      String?
  latePolicy    String?
  aiPolicy      String?
  officeHours   String?
  meetingTimes  String?
  hidden        Boolean        @default(false)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments   Assignment[]
  materials     Material[]
  calendarItems CalendarItem[]
  groups        Group[]
  conversations Conversation[]

  @@unique([userId, canvasId])
}

model Assignment {
  id              String    @id @default(cuid())
  courseId        String
  canvasId        Int
  title           String
  description     String?
  dueAt           DateTime?
  points          Float?
  submissionType  String
  htmlUrl         String
  rubric          Json?
  attachments     Json?
  isGroup         Boolean   @default(false)
  submittedAt     DateTime?
  score           Float?
  late            Boolean   @default(false)
  canvasUpdatedAt DateTime
  firstSeenAt     DateTime  @default(now())
  course          Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  calendarItems   CalendarItem[]
  conversations   Conversation[]

  @@unique([courseId, canvasId])
}

// Files, pages, links and announcements from Canvas. Summaries are added in M3.
model Material {
  id             String    @id @default(cuid())
  courseId       String
  canvasId       String
  type           String
  title          String
  moduleName     String?
  modulePosition Int?
  url            String
  contentType    String?
  size           Int?
  body           String?
  // AI notes keyed by language. Sync clears them when Canvas reports a new version.
  notes          Json?
  notesAt        DateTime?
  unsupported    String?
  postedAt       DateTime?
  firstSeenAt    DateTime  @default(now())
  course         Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, type, canvasId])
}

model CalendarItem {
  id           String      @id @default(cuid())
  userId       String
  courseId     String?
  assignmentId String?
  source       String
  canvasId     Int?
  title        String
  startAt      DateTime
  endAt        DateTime?
  allDay       Boolean     @default(false)
  location     String?
  // Canvas items are accepted on arrival; study blocks stay false until the student adds them.
  accepted     Boolean     @default(true)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([userId, source, canvasId])
}

model Group {
  id       String        @id @default(cuid())
  userId   String
  courseId String?
  canvasId Int
  name     String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  members  GroupMember[]

  @@unique([userId, canvasId])
}

model GroupMember {
  id           String @id @default(cuid())
  groupId      String
  canvasUserId Int
  name         String
  group        Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, canvasUserId])
}

// One run of the study assistant or the homework helper.
model Conversation {
  id           String      @id @default(cuid())
  userId       String
  kind         String
  situation    String?
  courseId     String?
  assignmentId String?
  title        String
  outcome      String?
  createdAt    DateTime    @default(now())
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  messages     Message[]
  draft        EmailDraft?
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  body           String
  language       String
  // The Canvas facts this reply was grounded in, shown as source chips.
  sources        Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

// Never sent by EZCanvas. The student opens it in their own mail client.
model EmailDraft {
  id             String       @id @default(cuid())
  conversationId String       @unique
  tone           String
  to             String
  subject        String
  body           String
  translation    String?
  openedAt       DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}
